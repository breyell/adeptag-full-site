{% extends 'layouts/default.twig' %}

{% block main %}
	{% include "components/blog-hero.twig" with {
    heading: post.title,
    image: post.featured_image,
    crop_image: post.crop_image,
  } %}
  {% for component in post.meta('blog_content') %}
    {% if component.acf_fc_layout in ['q_and_a', 'related_products'] %}
      {% include "components/" ~ component.acf_fc_layout | replace({'_': '-'}) ~ ".twig" with component %}
    {% else %}
      {% include "components/blog-content/" ~ component.acf_fc_layout | replace({'_': '-'}) ~ ".twig" with component %}
    {% endif %}
	{% endfor %}
{% endblock %}
